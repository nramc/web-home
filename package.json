{
    "name": "web-home",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "echo \"Tests skipped. Everything is fine.\" && exit 1",
        "lint": "eslint",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --write \"**/*.{ts,tsx}\"",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "security:check": "npm audit --audit-level=high",
        "housekeeping": "npm run lint:fix && npm run format",
        "prepare:commit": "npm run housekeeping && npm run typecheck && npm run build",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run security:check && npm run test"
    },
    "dependencies": {
        "class-variance-authority": "0.7.1",
        "cn": "0.5.0",
        "lucide-react": "1.61.0",
        "next": "16.4.2",
        "next-themes": "0.4.6",
        "radix-ui": "1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "shadcn": "4.22.1",
        "tw-animate-css": "1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.2",
        "prettier": "3.9.10",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2"
    }
}

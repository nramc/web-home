{
    "name": "web-home",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "echo \"Tests skipped. Everything is fine.\" && exit 1",
        "lint": "eslint",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --write \"**/*.{ts,tsx}\"",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "security:check": "npm audit --audit-level=high",
        "housekeeping": "npm run lint:fix && npm run format",
        "prepare:commit": "npm run housekeeping && npm run typecheck && npm run build",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run security:check && npm run test"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "cn": "^0.2.5",
        "lucide-react": "^1.41.0",
        "next": "16.3.4",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^22.0.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.4",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
